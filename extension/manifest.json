{
  "manifest_version": 3,
  "name": "Lightning",
  "version": "1.0.3",
  "description": "Send downloads to the Lightning desktop app, which fetches them over every network at once.",
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "action": {
    "default_title": "Lightning",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon.png", "32": "icons/icon.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["i18n.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["i18n.js", "youtube-select.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["context-capture.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["downloads", "cookies", "contextMenus", "storage", "notifications", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": { "id": "lightning-extension@lightning.app", "strict_min_version": "121.0" }
  }
}
